<?xml version="1.0" encoding="utf-8"?>
<!-- This file should be included by your project, one line in your .csproj:
       <Content Include="Content\Content.mgcb" />
-->
<mgcb:ContentPipelineProject xmlns:mgcb="MonoGame.ContentPipeline"
  xmlns="MonoGame.ContentPipeline" schema_version="1.0">
  <OutputDirectory>bin\$(Platform)</OutputDirectory>
  <Config>DesktopGL</Config>
  <Platform>Desktop</Platform>
  <Profile>HiDef</Profile>
  <Compress>false</Compress>
  <BuildTasks>
    <BuildTaskID>CopyTask</BuildTaskID>
    <BuildTaskID>MgcbBuilder</BuildTaskID>
  </BuildTasks>

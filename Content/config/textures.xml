<?xml version="1.0" encoding="utf-8"?>
<!-- Overrides de textures.
     Chaque textureOverride référence le nom d'une entité (joueur ou ennemi,
     tel que défini dans entities.xml / enemies.xml) et une texture alternative
     (chemin sans extension, dans Content/pics/).
     L'attribut sourceRect est optionnel ("x,y,w,h") pour les textures en
     feuille de sprites.
     Namespace: https://www.timc.fr/nicolas-glade/dotnet/shooter -->
<textures xmlns="https://www.timc.fr/nicolas-glade/dotnet/shooter"
          xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
          xsi:schemaLocation="https://www.timc.fr/nicolas-glade/dotnet/shooter shooter-config.xsd">

  <!-- Vaisseau du joueur : ship2 au lieu de ship1 -->
  <textureOverride name="Player" texture="pics/ships/ship1" />

  <!-- Ennemis : variantes visuelles -->
  <textureOverride name="EvilEye"   texture="pics/space/enemies/EvilEye_2" />
  <textureOverride name="Turret"    texture="pics/space/turrets/Base_2" />
  <textureOverride name="SpikeBall" texture="pics/space/spikeballs/Spike_Ball_2" />
  <textureOverride name="Boss"      texture="pics/space/ships/Spaceship_6" />

</textures>

<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net6.0</TargetFramework>
    <RollForward>Major</RollForward>
    <PublishReadyToRun>false</PublishReadyToRun>
    <TieredCompilation>false</TieredCompilation>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <!-- Mode headless activé par -p:Headless=true -->
  <PropertyGroup Condition="'$(Headless)'=='true'">
    <DefineConstants>$(DefineConstants);HEADLESS_TEST</DefineConstants>
  </PropertyGroup>

  <PropertyGroup>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Icon.ico</ApplicationIcon>
    <!-- The dotnet-mgcb CLI (3.8.1.303) rejects the legacy /option:value syntax
         that MonoGame.Content.Builder.Task generates; route it through the
         tools/ bridge that translates to long-form option=value syntax. -->
    <DotnetCommand>$(MSBuildProjectDirectory)/tools/dotnet-mgcb-bridge.sh</DotnetCommand>
  </PropertyGroup>

  <ItemGroup>
    <EmbeddedResource Include="Icon.ico" />
    <EmbeddedResource Include="Icon.bmp" />
  </ItemGroup>

  <!-- Config XML copied to the output directory, read at startup by GameConfig -->
  <ItemGroup>
    <Content Include="Content\config\**">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="MonoGame.Framework.DesktopGL" Version="3.8.1.303" />
    <PackageReference Include="MonoGame.Content.Builder.Task" Version="3.8.1.303" />
  </ItemGroup>

  <Target Name="RestoreDotnetTools" BeforeTargets="Restore" Condition="$(RestoreDotnetTools) != 'false'">
    <Message Text="Restoring dotnet tools (skip with -p:RestoreDotnetTools=false)" Importance="High" />
    <Exec Command="dotnet tool restore" />
  </Target>

  <!-- Supprimer la SDL2 bundled après le build (utilise SDL2 système) -->
  <Target Name="RemoveBundledSDL2" AfterTargets="Build">
    <Delete Files="$(OutputPath)runtimes/linux-x64/native/libSDL2-2.0.so.0" Condition="Exists('$(OutputPath)runtimes/linux-x64/native/libSDL2-2.0.so.0')" />
    <Message Text="Suppression de libSDL2-2.0.so.0 bundled" Importance="High" />
  </Target>

</Project>
